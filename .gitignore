# Learn more: https://docs.github.com/en/get-started/gitignore

# --- Dependencies ---
node_modules/

# --- Environment & secrets (never commit) ---
.env
.env.*
!.env.example

# --- Expo ---
.expo/
dist/
web-build/
expo-env.d.ts

# EAS local credentials / build artifacts
.eas/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
*.ipa
*.aab
*.apk
GoogleService-Info.plist
google-services.json

# --- Native (managed workflow: regenerate locally) ---
/ios
/android
.kotlin/
*.orig.*

# --- Metro / bundler ---
.metro-health-check*

# --- Logs & debug ---
npm-debug.*
yarn-debug.*
yarn-error.*
*.log
logs/

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- Editors & AI (local-only) ---
.idea/
.vscode/
.cursor/
.agent/
*.code-workspace
*.swp
*.swo
*~

# --- TypeScript / tooling ---
*.tsbuildinfo
.eslintcache
coverage/
.nyc_output/

# --- Temporary ---
*.tmp
*.temp
.turbo/
.cache/

# Maestro run dumps (keep curated evidence/<date>/screenshots/ + acceptance note)
docs/qa/**/commands-*
docs/qa/**/screenshot-*
# Maestro --test-output-dir timestamp folders (YYYY-MM-DD_HHMMSS)
docs/qa/**/evidence/**/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]_*
docs/qa/**/evidence/**/.maestro-runs/
# Intermediate visual-audit runs (not ship evidence; superseded by v2.6-01 Composition)
docs/qa/v2.5-01-composition/
# Mid-phase discuss / hand QA dumps (not ship archive)
docs/qa/v2.7-01-hydrate-resume/
docs/qa/v2.7-03-streak-freeze-calendar/

# --- Lockfile: this repo uses npm (package-lock.json) ---
yarn.lock

# --- Internal planning & agent docs (not for public repo) ---
.planning/
DESIGN.md
CLAUDE.md

.understand-anything

.codegraph
.code-review-graph/

project-data-analyse/*
.claude/
